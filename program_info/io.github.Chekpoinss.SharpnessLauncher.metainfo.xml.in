<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@Launcher_AppID@</id>
  <name>@Launcher_DisplayName@</name>
  <summary>Manage Minecraft instances with an integrated AI assistant</summary>
  <developer id="io.github.Chekpoinss"><name>Sharpness Launcher Contributors</name></developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Sharpness Launcher is an independent Prism Launcher fork for managing Minecraft Java Edition instances.</p>
    <ul>
      <li>Install mod loaders, mods, resource packs and modpacks.</li>
      <li>Use offline profiles without first adding a Microsoft account.</li>
      <li>Ask your own local or remote AI model for help and diagnose game logs.</li>
      <li>Connect external AI agents through a built-in MCP server.</li>
    </ul>
  </description>
  <releases><release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"/></releases>
  <url type="homepage">https://github.com/Chekpoinss/SharpnessLauncher</url>
  <url type="bugtracker">https://github.com/Chekpoinss/SharpnessLauncher/issues</url>
  <url type="vcs-browser">https://github.com/Chekpoinss/SharpnessLauncher</url>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">@Launcher_AppID@.desktop</launchable>
</component>
